<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/my_background_green">

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.95"
        app:layout_constraintWidth_percent="0.95">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhập câu hỏi"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Thêm câu hỏi của bạn ở đây"
                    android:background="@drawable/edittext_border"
                    android:padding="12dp"
                    android:textColor="@color/black"
                    android:textColorHint="#757575"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhập các đáp án"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <RadioGroup
                    android:id="@+id/radioGroupOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Option 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_blue"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:layout_marginTop="10dp">

                        <RadioButton
                            android:id="@+id/cbOption1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/white" />

                        <EditText
                            android:id="@+id/etOption1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Tùy chọn 1"
                            android:textColor="@android:color/white"
                            android:textColorHint="@android:color/white"
                            android:background="@android:color/transparent"
                            android:paddingStart="10dp" />
                    </LinearLayout>

                    <!-- Các lựa chọn 2, 3, 4 cũng tương tự, chỉ đổi ID và màu -->
                    <!-- Option 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/edittext_green"
                        android:padding="8dp">

                        <RadioButton
                            android:id="@+id/cbOption2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/white" />

                        <EditText
                            android:id="@+id/etOption2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Tùy chọn 2"
                            android:textColor="@android:color/white"
                            android:textColorHint="@android:color/white"
                            android:background="@android:color/transparent"
                            android:paddingStart="10dp" />
                    </LinearLayout>

                    <!-- Option 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/edittext_yellow"
                        android:padding="8dp">

                        <RadioButton
                            android:id="@+id/cbOption3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/black" />

                        <EditText
                            android:id="@+id/etOption3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Tùy chọn 3"
                            android:textColor="@android:color/black"
                            android:textColorHint="@android:color/black"
                            android:background="@android:color/transparent"
                            android:paddingStart="10dp" />
                    </LinearLayout>

                    <!-- Option 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/edittext_red"
                        android:padding="8dp">

                        <RadioButton
                            android:id="@+id/cbOption4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/white" />

                        <EditText
                            android:id="@+id/etOption4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Tùy chọn 4"
                            android:textColor="@android:color/white"
                            android:textColorHint="@android:color/white"
                            android:background="@android:color/transparent"
                            android:paddingStart="10dp" />
                    </LinearLayout>
                </RadioGroup>


                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/gray"
                    android:text="Lưu câu hỏi"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
