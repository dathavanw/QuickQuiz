<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.SearchQuizActivity">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="50dp">

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tìm kiếm"
            android:textSize="40sp" />

        <View
            android:id="@+id/separatorView"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@android:color/darker_gray" />

        <!-- Ô nhập tìm kiếm -->
        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_edittext"
            android:gravity="center"
            android:hint="Tìm kiếm quiz"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="8dp" />

        <!-- Nút chọn danh mục -->
        <HorizontalScrollView
            android:id="@+id/categoryScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoryLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGrades"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#D3D3D3"
                    android:minWidth="80dp"
                    android:text="Subject 1"
                    android:textColor="#000000"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnSubject"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#D3D3D3"
                    android:minWidth="80dp"
                    android:text="Subject 2"
                    android:textColor="#000000"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnChatGpt"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#D3D3D3"
                    android:minWidth="80dp"
                    android:text="Subject 3"
                    android:textColor="#000000"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/mathButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#D3D3D3"
                    android:minWidth="80dp"
                    android:text="Subject 4"
                    android:textColor="#000000"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/scienceButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="#D3D3D3"
                    android:minWidth="80dp"
                    android:text="Subject 5"
                    android:textColor="#000000"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- RecyclerView hiển thị danh sách quiz -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewQuiz"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1" />

        <!-- Hình ảnh trang trí -->
        <ImageView
            android:id="@+id/quizImage"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:src="@drawable/ic_quiz_search"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNoResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="Không tìm thấy kết quả phù hợp"
            android:textColor="@android:color/darker_gray"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include layout="@layout/bottom_nav_layout" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
